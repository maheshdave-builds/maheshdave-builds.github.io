# VITE_SUPABASE_URL is the project URL, e.g. https://abcdefghijkl.supabase.co
# VITE_SUPABASE_ANON_KEY is the public "anon" key. It is designed to be shipped to
# browsers; access is controlled by Row Level Security, not by secrecy.
# NEVER put the service_role key here — it bypasses all RLS policies.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
